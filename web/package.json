  "scripts": {
    "start": "node src/server.js",
    "docker:stop": "docker stop botcraft_server || true && docker rm botcraft_server || true",
    "docker:build": "docker build -t botcraft-web .",
    "docker:run": "[ -f .env ] && . ./.env; docker run -d --name botcraft_server -p ${PORT:-8000}:${PORT:-8000} $([ -f .env ] && echo \"--env-file .env\") botcraft-web",
    "docker:deploy": "npm run docker:stop && npm run docker:build && npm run docker:run",
    "docker:logs": "docker logs -f botcraft_server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
